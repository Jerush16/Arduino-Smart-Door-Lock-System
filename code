#include <Keypad.h>
#include <LiquidCrystal.h>
#include <Servo.h>

LiquidCrystal lcd(12, 11, 5, 4, 3, 2);

Servo lockServo;

const int servoPin = 10;

String password = "1234";
String inputPassword = "";

int wrongAttempts = 0;
bool lockedOut = false;

const byte ROWS = 4;
const byte COLS = 4;

char keys[ROWS][COLS] = {
  {'1','2','3','A'},
  {'4','5','6','B'},
  {'7','8','9','C'},
  {'*','0','#','D'}
};

byte rowPins[ROWS] = {A0, A1, A2, A3};
byte colPins[COLS] = {A4, A5, 6, 7};

Keypad keypad = Keypad(makeKeymap(keys), rowPins, colPins, ROWS, COLS);

void setup()
{
  lcd.begin(16, 2);

  lockServo.attach(servoPin);
  lockServo.write(0);

  lcd.setCursor(0,0);
  lcd.print("Smart Door Lock");
  delay(2000);

  showEnterPassword();
}

void loop()
{
  if (lockedOut)
  {
    return;
  }

  char key = keypad.getKey();

  if (key)
  {
    if (key >= '0' && key <= '9')
    {
      inputPassword += key;

      lcd.setCursor(inputPassword.length()-1,1);
      lcd.print("*");
    }

    else if (key == '#')
    {
      verifyPassword();
    }

    else if (key == '*')
    {
      changePassword();
    }
  }
}

void showEnterPassword()
{
  lcd.clear();
  lcd.setCursor(0,0);
  lcd.print("Enter Password");
  lcd.setCursor(0,1);
}

void verifyPassword()
{
  if (inputPassword == password)
  {
    lcd.clear();
    lcd.print("Access Granted");

    lockServo.write(90);

    delay(5000);

    lockServo.write(0);

    lcd.clear();
    lcd.print("Door Locked");

    delay(2000);

    wrongAttempts = 0;
  }
  else
  {
    wrongAttempts++;

    lcd.clear();
    lcd.print("Wrong Password");

    delay(2000);

    if (wrongAttempts >= 3)
    {
      activateLockout();
      return;
    }
  }

  inputPassword = "";
  showEnterPassword();
}

void activateLockout()
{
  lockedOut = true;

  lcd.clear();
  lcd.print("LOCKED OUT!");
  lcd.setCursor(0,1);
  lcd.print("Wait 30 Sec");

  delay(30000);

  wrongAttempts = 0;
  lockedOut = false;

  showEnterPassword();
}

void changePassword()
{
  lcd.clear();
  lcd.print("Current Pass:");
  lcd.setCursor(0,1);

  String oldPass = "";

  while (oldPass.length() < 4)
  {
    char key = keypad.getKey();

    if (key && key >= '0' && key <= '9')
    {
      oldPass += key;
      lcd.print("*");
    }
  }

  delay(1000);

  if (oldPass == password)
  {
    lcd.clear();
    lcd.print("New Password:");
    lcd.setCursor(0,1);

    String newPass = "";

    while (newPass.length() < 4)
    {
      char key = keypad.getKey();

      if (key && key >= '0' && key <= '9')
      {
        newPass += key;
        lcd.print("*");
      }
    }

    password = newPass;

    lcd.clear();
    lcd.print("Password Set");
    delay(2000);
  }
  else
  {
    lcd.clear();
    lcd.print("Wrong Current");
    delay(2000);
  }

  showEnterPassword();
}
